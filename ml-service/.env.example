# ML Service Configuration
PORT=8000
HOST=0.0.0.0

# Security secret for backend-to-ML authentication
ML_SERVICE_SECRET=your-ml-service-secret-key-change-me

# Risk Thresholds for mapping normalized anomaly score to risk levels
# Anomaly score range [0, 1]
RISK_THRESHOLD_LOW=0.35
RISK_THRESHOLD_MEDIUM=0.60
RISK_THRESHOLD_HIGH=0.80

# Isolation Forest Hyperparameters
IFOREST_N_ESTIMATORS=100
IFOREST_CONTAMINATION=0.05
IFOREST_RANDOM_STATE=42

# Optional Express Backend API Integration URL
BACKEND_URL=http://localhost:5000
